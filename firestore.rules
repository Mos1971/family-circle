rules_version = '2';

// Family Circle security rules (multi-tenant).
//
// Every customer gets their own "circle". All of a circle's data lives under
// /circles/{circleId}/..., and a person can only touch circles where they have
// an approved profile (/circles/{circleId}/members/{uid}). One sign-in can
// belong to many circles.
//
// Principles:
//  * Nobody can do anything unless signed in (except checking an invite or
//    licence code during sign-up).
//  * A newly registered member is "pending": they can see only their own
//    profile and their circle's name until that circle's admin approves them.
//  * Private data (messages, private events, lists, notifications) is only
//    readable by the people it belongs to — never by other circles, never by
//    the app owner.
//  * New circles can only be created with a valid one-time licence code.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(cid, uid) {
      return /databases/$(database)/documents/circles/$(cid)/members/$(uid);
    }

    // Approved member of this specific circle.
    function inCircle(cid) {
      return signedIn()
        && exists(memberPath(cid, request.auth.uid))
        && get(memberPath(cid, request.auth.uid)).data.status == 'approved';
    }

    function adminOf(cid) {
      return inCircle(cid)
        && get(memberPath(cid, request.auth.uid)).data.role == 'admin';
    }

    function approvedInCircle(uid, cid) {
      return exists(memberPath(cid, uid))
        && get(memberPath(cid, uid)).data.status == 'approved';
    }

    // ---- licence codes (issued by the app owner) -------------------------
    // Codes are long and random, so they can be checked one at a time but
    // never listed.
    match /licenses/{code} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      // Redeeming: unused -> used, nothing else.
      allow update: if signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['used', 'circleId', 'usedBy', 'usedAt']);
    }

    // ---- invite codes (one per circle) -----------------------------------
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      // Only created together with the circle, by that circle's owner.
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/inviteCodes/$(code))
        && getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- accounts --------------------------------------------------------
    // One document per sign-in: which circles you belong to and which is
    // active. Only you can see or change it.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['email', 'activeCircleId', 'circleIds', 'circleNames']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['email', 'activeCircleId', 'circleIds', 'circleNames']);
      allow delete: if false;
    }

    // ---- circles ---------------------------------------------------------
    match /circles/{cid} {
      // Anyone with a profile in the circle (even pending) can see its name.
      allow get: if signedIn() && exists(memberPath(cid, request.auth.uid));
      allow list: if false;

      // Creating a circle burns a valid, unused licence in the same batch.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/licenses/$(request.resource.data.licenseCode))
        && get(/databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)).data.used == false
        && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)).data.used == true
        && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)).data.circleId == cid;

      allow update: if adminOf(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;

      // ---- members: a person's profile inside this circle -------------------
      match /members/{memberId} {
        // Approved members see everyone in the circle; anyone can see their
        // own profile (so a pending member can see their status).
        allow read: if inCircle(cid) || (signedIn() && request.auth.uid == memberId);

        allow create: if signedIn()
          && request.auth.uid == memberId
          && !exists(memberPath(cid, memberId))
          && request.resource.data.keys().hasOnly([
               'firstName', 'familyName', 'email', 'bio', 'role', 'status',
               'joinDate', 'postCount', 'profileEmoji', 'prefs'
             ])
          && (
            // Joining an existing circle: always pending, always a member.
            (request.resource.data.status == 'pending'
              && request.resource.data.role == 'member'
              && exists(/databases/$(database)/documents/circles/$(cid)))
            ||
            // Founding a brand-new circle: admin of a circle created in the
            // same batch (it did not exist before).
            (request.resource.data.status == 'approved'
              && request.resource.data.role == 'admin'
              && !exists(/databases/$(database)/documents/circles/$(cid))
              && getAfter(/databases/$(database)/documents/circles/$(cid)).data.ownerId == request.auth.uid)
          );

        allow update:
          // Members can edit their own harmless fields.
          if (signedIn() && request.auth.uid == memberId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['bio', 'prefs', 'postCount', 'profileEmoji']))
          // Admins can approve/remove members and change roles.
          || (adminOf(cid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'role']));

        allow delete: if false;
      }

      // ---- feed ----------------------------------------------------------
      match /posts/{postId} {
        allow read: if inCircle(cid);
        // Normal posts are authored by the poster; admins also create the
        // automatic "welcome" post on behalf of a newly approved member.
        allow create: if inCircle(cid)
          && ((request.resource.data.authorId == request.auth.uid)
              || (adminOf(cid) && request.resource.data.type == 'welcome'));
        // Reactions / report counter / hidden flag only.
        allow update: if inCircle(cid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'reportedCount', 'hidden']);
        allow delete: if inCircle(cid)
          && (resource.data.authorId == request.auth.uid || adminOf(cid));
      }

      match /comments/{commentId} {
        allow read: if inCircle(cid);
        allow create: if inCircle(cid) && request.resource.data.authorId == request.auth.uid;
        allow delete: if inCircle(cid)
          && (resource.data.authorId == request.auth.uid || adminOf(cid));
        allow update: if false;
      }

      match /reports/{reportId} {
        allow create: if inCircle(cid) && request.resource.data.reporterId == request.auth.uid;
        allow read, update, delete: if adminOf(cid);
      }

      // ---- announcements -------------------------------------------------
      match /announcements/{id} {
        allow read: if inCircle(cid);
        allow create, update, delete: if adminOf(cid);
      }

      // ---- notifications -------------------------------------------------
      // Any member can send a notification to someone in the same circle
      // (e.g. "X sent you a message"); only the recipient can read or change it.
      match /notifications/{id} {
        allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
        allow create: if inCircle(cid)
          && approvedInCircle(request.resource.data.userId, cid);
        allow update: if signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // ---- group chats ---------------------------------------------------
      // A group's record (name + members). Private one-to-one chats have no
      // record; their id alone names the two people.
      match /chats/{chatId} {
        allow read: if inCircle(cid) && request.auth.uid in resource.data.participants;
        allow create: if inCircle(cid)
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() >= 2
          && request.resource.data.participants.size() <= 60;
        // Members can add people or leave; only the creator can rename.
        allow update: if inCircle(cid)
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participants', 'name'])
          && request.resource.data.participants.size() <= 60
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
              || resource.data.createdBy == request.auth.uid)
          && (request.resource.data.participants.hasAll(resource.data.participants)
              || (!(request.auth.uid in request.resource.data.participants)
                  && request.resource.data.participants.hasAll(
                       resource.data.participants.removeAll([request.auth.uid]))));
        allow delete: if false;
      }

      // ---- messages (private chats and groups) ---------------------------
      // Each message carries the list of people who could see the chat when it
      // was sent. Only those people can ever read it.
      match /messages/{id} {
        allow read: if inCircle(cid) && request.auth.uid in resource.data.participants;
        allow create: if inCircle(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() >= 2
          && request.resource.data.participants.size() <= 60
          && (
            // Private chat: exactly two people, and the other is a member.
            (request.resource.data.chatId.matches('dm[|].*')
              && request.resource.data.participants.size() == 2
              && approvedInCircle(
                   request.resource.data.participants.removeAll([request.auth.uid])[0], cid))
            ||
            // Group chat: must match the group's current member list.
            (exists(/databases/$(database)/documents/circles/$(cid)/chats/$(request.resource.data.chatId))
              && get(/databases/$(database)/documents/circles/$(cid)/chats/$(request.resource.data.chatId)).data.participants
                   == request.resource.data.participants)
          );
        // A participant can mark a message read (only ever adding themselves).
        allow update: if inCircle(cid)
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.get('readBy', []));
        allow delete: if false;
      }

      // ---- calendar ------------------------------------------------------
      match /events/{id} {
        // Family events are visible to every member; private ones to the owner.
        allow read: if (inCircle(cid) && resource.data.shared == true)
          || (signedIn() && resource.data.ownerId == request.auth.uid);
        allow create: if inCircle(cid) && request.resource.data.ownerId == request.auth.uid;
        allow update: if inCircle(cid) && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if inCircle(cid)
          && (resource.data.ownerId == request.auth.uid
              || (resource.data.shared == true && adminOf(cid)));
      }

      // ---- to-do lists ---------------------------------------------------
      // 'members' = owner + the people the list is shared with.
      match /todoLists/{id} {
        allow read: if signedIn() && request.auth.uid in resource.data.members;
        allow create: if inCircle(cid)
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid in request.resource.data.members;
        // Any member can tick/add items; only the owner can change sharing.
        allow update: if signedIn()
          && request.auth.uid in resource.data.members
          && request.resource.data.ownerId == resource.data.ownerId
          && (resource.data.ownerId == request.auth.uid
              || (request.resource.data.sharedWith == resource.data.sharedWith
                  && request.resource.data.members == resource.data.members));
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }
    }

    // Everything else is locked (including the old un-circled collections).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
